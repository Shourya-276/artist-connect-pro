generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(CLIENT)
  isVerified    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  activityLogs  ActivityLog[]
  artistProfile ArtistProfile?
  clientProfile ClientProfile?
}

model Category {
  id      String          @id @default(uuid())
  name    String          @unique
  icon    String?
  artists ArtistProfile[]
}

model Genre {
  id      String          @id @default(uuid())
  name    String          @unique
  artists ArtistProfile[] @relation("ArtistGenres")
}

model City {
  id      String          @id @default(uuid())
  name    String          @unique
  artists ArtistProfile[]
}

model ArtistProfile {
  id               String             @id @default(uuid())
  userId           String             @unique
  name             String
  bio              String?            @db.Text
  priceRange       String?
  rating           Float              @default(0)
  totalReviews     Int                @default(0)
  verifiedStatus   VerificationStatus @default(PENDING)
  travelNationwide Boolean            @default(false)
  profileImage     String?
  categoryId       String?
  cityId           String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  coverImage       String?
  isTopSeller      Boolean            @default(false)
  isTrending       Boolean            @default(false)
  area             String?
  budgetChart      Json?
  eventCategories  Json?
  facebook         String?
  gender           String?
  instagram        String?
  instruments      Json?
  languages        Json?
  phone            String?
  website          String?
  youtube          String?
  availability     Json?
  category         Category?          @relation(fields: [categoryId], references: [id])
  city             City?              @relation(fields: [cityId], references: [id])
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stats            ArtistStats?
  bookings         Booking[]
  enquiries        Enquiry[]
  media            Media[]
  reviews          Review[]
  shortlists       Shortlist[]
  genres           Genre[]            @relation("ArtistGenres")

  @@index([categoryId], map: "ArtistProfile_categoryId_fkey")
  @@index([cityId], map: "ArtistProfile_cityId_fkey")
}

model Media {
  id              String        @id @default(uuid())
  url             String        @db.Text
  type            MediaType
  artistProfileId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  artistProfile   ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)

  @@index([artistProfileId], map: "Media_artistProfileId_fkey")
}

model ClientProfile {
  id          String      @id @default(uuid())
  userId      String      @unique
  name        String
  companyName String?
  phone       String?
  location    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  bookings    Booking[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  enquiries   Enquiry[]
  reviews     Review[]
  shortlists  Shortlist[]
}

model ArtistStats {
  id              String        @id @default(uuid())
  artistProfileId String        @unique
  views           Int           @default(0)
  enquiriesCount  Int           @default(0)
  bookingsCount   Int           @default(0)
  shortlistCount  Int           @default(0)
  updatedAt       DateTime      @updatedAt
  artistProfile   ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
}

model Enquiry {
  id        String        @id @default(uuid())
  clientId  String
  artistId  String
  eventDate DateTime
  eventType String
  message   String?       @db.Text
  status    EnquiryStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  booking   Booking?
  artist    ArtistProfile @relation(fields: [artistId], references: [id])
  client    ClientProfile @relation(fields: [clientId], references: [id])

  @@index([artistId], map: "Enquiry_artistId_fkey")
  @@index([clientId], map: "Enquiry_clientId_fkey")
}

model Booking {
  id              String        @id @default(uuid())
  enquiryId       String        @unique
  clientId        String
  artistId        String
  amount          Decimal       @db.Decimal(10, 2)
  paymentStatus   String        @default("PENDING")
  status          BookingStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  hasBeenReviewed Boolean       @default(false)
  artist          ArtistProfile @relation(fields: [artistId], references: [id])
  client          ClientProfile @relation(fields: [clientId], references: [id])
  enquiry         Enquiry       @relation(fields: [enquiryId], references: [id])

  @@index([artistId], map: "Booking_artistId_fkey")
  @@index([clientId], map: "Booking_clientId_fkey")
}

model Shortlist {
  id        String        @id @default(uuid())
  clientId  String
  artistId  String
  createdAt DateTime      @default(now())
  artist    ArtistProfile @relation(fields: [artistId], references: [id])
  client    ClientProfile @relation(fields: [clientId], references: [id])

  @@unique([clientId, artistId])
  @@index([artistId], map: "Shortlist_artistId_fkey")
}

model Review {
  id           String         @id @default(uuid())
  artistId     String
  clientId     String?
  reviewerName String?
  rating       Int
  comment      String?        @db.Text
  isApproved   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  artist       ArtistProfile  @relation(fields: [artistId], references: [id], onDelete: Cascade)
  client       ClientProfile? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([artistId], map: "Review_artistId_fkey")
  @@index([clientId], map: "Review_clientId_fkey")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "ActivityLog_userId_fkey")
}

model HomePageStat {
  id    String @id @default(uuid())
  label String
  value String
}

model Testimonial {
  id     String  @id @default(uuid())
  name   String
  role   String?
  text   String  @db.Text
  rating Int     @default(5)
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  createdAt DateTime @default(now())
}

enum Role {
  ARTIST
  CLIENT
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum EnquiryStatus {
  PENDING
  RESPONDED
  CLOSED
}

enum MediaType {
  IMAGE
  VIDEO
}
